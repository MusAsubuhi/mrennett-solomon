# Copy this file to .env.local and fill in what you know.
NEXT_PUBLIC_SITE_URL=              # e.g. https://www.example.com (no trailing slash)
NEXT_PUBLIC_WHATSAPP_NUMBER=       # international format, no plus sign, e.g. 2547XXXXXXXX
NEXT_PUBLIC_CURRENCY=KES           # assumption, confirm
NEXT_PUBLIC_ANALYTICS_ID=          # optional. Plausible site domain, e.g. example.com. Empty = no analytics
NEWSLETTER_PROVIDER_KEY=           # server-side only, optional (for example Brevo)
# Optional: show "Content needed" boxes and image-slot hints on a deployed preview
# NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
